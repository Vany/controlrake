// =============================================================================
// 🏭 UNIVERSAL TEST FACTORIES - Eliminate Mock Duplication
// =============================================================================

/// 🔧 Universal test bus handle factory
pub fn create_test_bus() -> BusHandle {
    BusHandle::new_test()
}

/// 🔧 Create test bus with real message bus for integration tests
pub async fn create_test_bus_with_routing() -> BusHandle {
    let bus = crate::Bus::new().await;
    bus.handle()
}

/// 📝 Universal test message factory
pub fn create_test_message(target: &str, payload: Value) -> Message {
    Message {
        target: target.parse().unwrap_or_else(|_| {
            panic!("Invalid test target address: {}", target)
        }),
        source: Some("test:source".parse().unwrap()),
        payload,
        id: Some(crate::message::MessageId::new()),
        reply: None,
        finish: false,
    }
}

/// 📋 Universal test context factory for method handlers
pub fn create_test_context(component_id: &str, bus_handle: BusHandle, payload: Value) -> MethodContext {
    use handlebars::Handlebars;
    use crate::component_framework::{SystemStorageAdapter, ComponentState};
    
    let templates = Arc::new(RwLock::new(Handlebars::new()));
    let storage = Arc::new(SystemStorageAdapter::new(bus_handle.clone(), component_id.to_string()));
    let state = Arc::new(RwLock::new(ComponentState::new()));
    
    MethodContext {
        component_id: component_id.to_string(),
        bus_handle,
        message: create_test_message(&format!("{}:.test", component_id), payload),
        templates,
        storage,
        state,
    }
}

