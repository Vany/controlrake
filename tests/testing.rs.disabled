// =============================================================================
// 🧪 UNIVERSAL TEST TRAITS - Standardized Testing Patterns
// =============================================================================

/// 🔬 Universal component testing trait - applies to all components

/// 🔬 State extraction testing trait - for framework components
/// 🔬 State extraction testing trait - for framework components
pub trait StateExtractionTesting<StatusType, MessageType> 
where 
    StatusType: Clone,
    MessageType: Clone,
    Self: ComponentStateExtractor<StatusType, MessageType>,
{
    /// Test common state extraction
    fn test_state_extraction(&self) {
        let state = self.extract_common_state();
        
        // Verify state bundle contains proper references
        assert!(Arc::strong_count(&state.status) >= 1, 
                "Status should have valid reference count");
        assert!(Arc::strong_count(&state.chat_messages) >= 1, 
                "Messages should have valid reference count");
        assert!(Arc::strong_count(&state.version) >= 1, 
                "Version should have valid reference count");
    }
}

/// 🔬 Handler testing trait - for method handlers
#[async_trait]
pub trait HandlerTesting: MethodHandler {
    /// Test handler with valid payload
    async fn test_valid_payload(&self, ctx: &MethodContext) {
        let payload = json!({"test": "valid_data"});
        let result = self.handle(ctx, payload).await;
        
        // Handler should either succeed or fail gracefully
        match result {
            Ok(response) => {
                assert!(response.is_object() || response.is_string(), 
                        "Valid response should be object or string");
            }
            Err(e) => {
                // Error should have meaningful message
                assert!(!e.to_string().is_empty(), 
                        "Error message should not be empty");
            }
        }
    }
    
    /// Test handler with invalid payload
    async fn test_invalid_payload(&self, ctx: &MethodContext) {
        let invalid_payloads = vec![
            json!(null),
            json!("invalid_string"),
            json!(42),
            json!({"missing": "required_fields"}),
        ];
        
        for payload in invalid_payloads {
            let result = self.handle(ctx, payload).await;
            // Handler should handle invalid data gracefully
            // Either return error response or success with error field
            match result {
                Ok(response) => {
                    if let Some(error) = response.get("error") {
                        assert!(error.is_string(), "Error field should be string");
                    }
                }
                Err(_) => {
                    // Returning error is also acceptable
                }
            }
        }
    }
    
    /// Test handler timeout behavior
    async fn test_timeout_behavior(&self, ctx: &MethodContext) {
        let payload = json!({"test": "timeout_test"});
        
        // Handler should complete within reasonable time
        let result = timeout(Duration::from_secs(5), self.handle(ctx, payload.clone())).await;
        assert!(result.is_ok(), "Handler should complete within 5 seconds");
    }
}

// =============================================================================
// 🔧 UNIVERSAL TEST UTILITIES - Shared Helper Functions
// =============================================================================

/// 🛠️ Test utilities for common operations
pub mod utilities {
    use super::*;
    
    /// Validate JSON response structure
    pub fn validate_response_structure(response: &Value) -> bool {
        if let Some(obj) = response.as_object() {
            // Should have either success or error field
            obj.contains_key("success") || obj.contains_key("error")
        } else {
            false
        }
    }
    
    /// Validate update message structure
    pub fn validate_update_message(update: &UpdateMessage) -> bool {
        // Basic validation - ensure selector is not empty
        !update.get_selector().is_empty()
    }
    
    /// Validate HTML output
    pub fn validate_html_output(html: &str) -> bool {
        // Basic checks for valid HTML
        !html.is_empty() && 
        !html.contains("<script>") && // No inline scripts
        html.contains('<') && html.contains('>') // Has HTML tags
    }
    
    /// Validate component configuration
    pub fn validate_config(config: &Value) -> bool {
        config.is_object() || config.is_null()
    }
    
    /// Create mock WebSocket connection ID
    pub fn mock_websocket_id() -> String {
        format!("test-ws-{}", uuid::Uuid::new_v4())
    }
    
    /// Create mock component address
    pub fn mock_component_address(class: &str, id: &str) -> String {
        format!("{}:{}", class, id)
    }
    
    /// Wait for async operation with timeout
    pub async fn wait_for_condition<F, Fut>(condition: F, timeout_secs: u64) -> bool 
    where
        F: Fn() -> Fut,
        Fut: std::future::Future<Output = bool>,
    {
        let start = std::time::Instant::now();
        let timeout_duration = Duration::from_secs(timeout_secs);
        
        while start.elapsed() < timeout_duration {
            if condition().await {
                return true;
            }
            tokio::time::sleep(Duration::from_millis(50)).await;
        }
        false
    }
}

// =============================================================================
// 🏗️ UNIVERSAL MOCK COMPONENTS - For Integration Testing
// =============================================================================

/// 🎭 Mock component for testing framework integration
pub struct MockComponent {
    id: String,
    bus_handle: BusHandle,
    version: Arc<AtomicU64>,
    handler: Option<Arc<ComponentHandler>>,
}

/// 🎭 Mock method handler for testing
pub struct MockHandler {
    response_data: Value,
    should_error: bool,
}

impl MockHandler {
    pub fn new_success(response: Value) -> Self {
        Self {
            response_data: response,
            should_error: false,
        }
    }
    
    pub fn new_error() -> Self {
        Self {
            response_data: json!({"error": "Mock error"}),
            should_error: true,
        }
    }
}

#[async_trait]
impl MethodHandler for MockHandler {
    async fn handle(&self, _ctx: &MethodContext, _payload: Value) -> Result<Value> {
        if self.should_error {
            Err(anyhow::anyhow!("Mock handler error"))
        } else {
            Ok(self.response_data.clone())
        }
    }
}

