<div id="http-{{id}}" class="consolidated-http-container">
    <h3>🌐 HTTP Gateway</h3>
    <div class="http-status">
        <div class="status-indicator">{{status}}</div>
        <div class="port-info">Port: {{port}}</div>
        <div class="base-url">Base URL: {{base_url}}</div>
    </div>
    
    <div class="http-stats">
        <div class="stat-item">
            <span class="label">WebSocket Connections:</span>
            <span class="value connections">{{connection_count}}</span>
        </div>
        <div class="stat-item">
            <span class="label">Registered Callbacks:</span>
            <span class="value callbacks">{{callback_count}}</span>
        </div>
        <div class="stat-item">
            <span class="label">Static Folder:</span>
            <span class="value">{{static_folder}}</span>
        </div>
        <div class="stat-item">
            <span class="label">Bind Address:</span>
            <span class="value">{{bind_address}}</span>
        </div>
    </div>
    
    <div class="http-actions">
        <button onclick="self.send('websocket_stats')" class="action-button">
            📊 Get WebSocket Stats
        </button>
        <button onclick="window.open('/static/', '_blank')" class="action-button">
            📁 View Static Files
        </button>
    </div>
    
    <div class="framework-info">
        <small>✨ Powered by Enhanced Component Framework v{{version}}</small>
    </div>
</div>

<style>
.consolidated-http-container {
    padding: 1rem;
    border: 1px solid #333;
    border-radius: 8px;
    background: #1a1a1a;
    color: white;
    font-family: monospace;
}

.http-status {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.5rem;
    background: #2a2a2a;
    border-radius: 4px;
}

.status-indicator {
    font-weight: bold;
}

.http-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0.5rem;
    background: #2a2a2a;
    border-radius: 4px;
}

.label {
    color: #aaa;
}

.value {
    color: #0ff;
    font-weight: bold;
}

.http-actions {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.action-button {
    padding: 0.5rem 1rem;
    background: #333;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    cursor: pointer;
    font-family: monospace;
}

.action-button:hover {
    background: #444;
}

.framework-info {
    text-align: center;
    color: #666;
    font-style: italic;
}
</style>
