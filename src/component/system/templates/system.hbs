<div id="system-dashboard" class="system-component">
    <div class="component-header">
        <h3>🎛️ System Component</h3>
        <span class="component-id">{{component_id}}</span>
        <span class="version">v{{version}}</span>
    </div>
    
    <div class="system-stats">
        <div class="stat-row">
            <label>Config Loaded:</label>
            <span class="status {{#if config_loaded}}success{{else}}error{{/if}}">
                {{#if config_loaded}}✅ Yes{{else}}❌ No{{/if}}
            </span>
        </div>
        
        <div class="stat-row">
            <label>Default Instances:</label>
            <span class="count">{{well_known_instances}}</span>
        </div>
        
        <div class="stat-row">
            <label>Dynamic Instances:</label>
            <span class="count">{{dynamic_instances}}</span>
        </div>
        
        <div class="stat-row">
            <label>Total Components:</label>
            <span class="count total">{{total_components}}</span>
        </div>
    </div>

    <div class="system-actions">
        <button onclick="self.send('get_component_list')" class="action-btn">
            📋 List Components
        </button>
        <button onclick="self.send('get_storage_stats')" class="action-btn">
            🗄️ Storage Stats
        </button>
        <button onclick="self.send('get_system_health')" class="action-btn">
            💚 System Health
        </button>
    </div>

    <div class="system-info">
        <small>System Management Interface - Component Registry & Storage</small>
    </div>
</div>

<style>
.system-component {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 1rem;
    font-family: system-ui, -apple-system, sans-serif;
}

.component-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #dee2e6;
    padding-bottom: 0.5rem;
}

.component-header h3 {
    margin: 0;
    color: #495057;
}

.component-id {
    background: #e9ecef;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-family: monospace;
}

.version {
    background: #6c757d;
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
}

.system-stats {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem;
    background: white;
    border-radius: 4px;
    border: 1px solid #e9ecef;
}

.stat-row label {
    font-weight: 500;
    color: #495057;
}

.status.success {
    color: #28a745;
}

.status.error {
    color: #dc3545;
}

.count {
    font-weight: 600;
    color: #495057;
}

.count.total {
    color: #007bff;
}

.system-actions {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
}

.action-btn {
    background: #007bff;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background-color 0.2s;
}

.action-btn:hover {
    background: #0056b3;
}

.system-info {
    text-align: center;
    color: #6c757d;
    font-style: italic;
}
</style>
